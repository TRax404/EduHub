model Book {
    id       String  @id @default(cuid())
    customId String  @unique
    title    String
    image    String?
    year     String

    totalQuestions    Int @default(0)
    dailyAttemptLimit Int @default(3)

    isVisible ContentStatus @default(TEST)

    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt
    deletedAt DateTime?

    chapters Chapter[]

    // leaderboardEntries LeaderboardEntry[]

    @@index([isVisible])
    @@index([deletedAt])
}

model Chapter {
    id       String  @id @default(uuid())
    title    String
    customId String  @unique
    image    String?
    order    Int
    year     String

    bookId String
    book   Book   @relation(fields: [bookId], references: [id])

    isVisible ContentStatus @default(TEST)
    questions Question[]

    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt
    deletedAt DateTime?
}

